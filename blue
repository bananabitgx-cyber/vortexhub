---------------------------------------------------------
-- ADVANCED COMBAT REMOTES DETECTION (SERVER EXPLOIT BYPASS)
---------------------------------------------------------
local function forceServerDamage()
	local char = LocalPlayer.Character
	if not char then return end

	-- Automatically force equip weapon
	local tool = char:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
	if tool then
		if tool.Parent == LocalPlayer.Backpack then
			tool.Parent = char
		end
		tool:Activate() -- Standard physical hit trigger
	end

	-- UNIVERSAL MOBILE REMOTE BYPASS LAYER
	-- Automatically searches the game's network system for combat events and triggers them
	pcall(function()
		local remotes = {
			ReplicatedStorage:FindFirstChild("CombatEvent"),
			ReplicatedStorage:FindFirstChild("RigControllerEvent"), -- Blox Fruits Style
			ReplicatedStorage:FindFirstChild("MainRemote"),
			char:FindFirstChildOfClass("Tool") and char:FindFirstChildOfClass("Tool"):FindFirstChildOfClass("RemoteEvent")
		}
		
		for _, remote in pairs(remotes) do
			if remote and remote:IsA("RemoteEvent") then
				remote:FireServer() -- Forces the server to authorize the damage packet
			end
		end
	end)
end

---------------------------------------------------------
-- HEALTH-FILTER TARGET FINDER (DEFEATS SAFE-ZONE QUEST NPCs)
---------------------------------------------------------
local function getRealCombatEnemy()
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	
	local closest, maxDist = nil, math.huge
	local allObjects = workspace:GetDescendants()
	
	for i = 1, #allObjects do
		local obj = allObjects[i]
		
		if obj:IsA("Humanoid") and obj.Parent and obj.Parent ~= char then
			local rootPart = obj.Parent:FindFirstChild("HumanoidRootPart") or obj.Parent:FindFirstChild("Torso") or obj.Parent:FindFirstChild("UpperTorso")
			
			if rootPart and obj.Health > 0 then
				-- CRITICAL FILTER FIX: Real hostile enemies have custom health bars.
				-- Quest/Safe Zone NPCs are default Roblox rigs (exactly 100 max health) or invincible (0 max health).
				if obj.MaxHealth > 101 or (obj.MaxHealth > 5 and obj.MaxHealth < 100) then
					local dist = (char.HumanoidRootPart.Position - rootPart.Position).Magnitude
					if dist < maxDist then
						maxDist = dist
						closest = obj.Parent
					end
				end
			end
		end
	end
	return closest
end

---------------------------------------------------------
-- OPERATIONS CORE THREADS
---------------------------------------------------------
task.spawn(function()
	while task.wait(0.05) do 
		if Config.AutoFarm or Config.KillAura then
			local target = getRealCombatEnemy()
			local char = LocalPlayer.Character
			
			if target and char and char:FindFirstChild("HumanoidRootPart") then
				local targetRoot = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso") or target:FindFirstChild("UpperTorso")
				
				if targetRoot then
					-- Teleport directly above the real hostile enemy
					if Config.AutoFarm then
						char.HumanoidRootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 5.5, 0)
					end
					
					-- Force attack loop
					if Config.KillAura and (char.HumanoidRootPart.Position - targetRoot.Position).Magnitude <= 35 then
						forceServerDamage()
						task.wait(Config.AttackSpeed)
					end
				end
			end
		end
	end
end)

task.spawn(function()
	while task.wait(0.5) do
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("Humanoid") then
			char.Humanoid.WalkSpeed = Config.WalkSpeedValue
		end
	end
end)

