---------------------------------------------------------
-- UNIVERSAL AUTO-ATTACK MOTOR (SERVER SYNCHRONIZED)
---------------------------------------------------------
local function autoAttack()
	local char = LocalPlayer.Character
	if not char then return end

	-- 1. Automatically find any weapon/tool in your Backpack or Character
	local tool = char:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
	
	if tool then
		-- Equip the tool automatically if it's sitting in your backpack
		if tool.Parent == LocalPlayer.Backpack then
			tool.Parent = char
		end
		
		-- 2. Force the tool to activate on the server (Swings sword / fires gun)
		tool:Activate()
		
		-- 3. Bypass common combat security structures by simulating a physical click
		local combatRemote = tool:FindFirstChildOfClass("RemoteEvent") or tool:FindFirstChildOfClass("RemoteFunction")
		if combatRemote then
			combatRemote:FireServer()
		end
	end
end

local function getClosestTarget()
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	
	local closest, maxDist = nil, math.huge
	local allObjects = workspace:GetDescendants()
	
	for i = 1, #allObjects do
		local obj = allObjects[i]
		if obj:IsA("Humanoid") and obj.Parent and obj.Parent ~= char then
			local rootPart = obj.Parent:FindFirstChild("HumanoidRootPart") or obj.Parent:FindFirstChild("Torso") or obj.Parent:FindFirstChild("UpperTorso")
			if rootPart and obj.Health > 0 then
				local dist = (char.HumanoidRootPart.Position - rootPart.Position).Magnitude
				if dist < maxDist then
					maxDist = dist
					closest = obj.Parent
				end
			end
		end
	end
	return closest
end

---------------------------------------------------------
-- PERFORMANCE THREAD CONTROLLERS
---------------------------------------------------------
task.spawn(function()
	while task.wait(0.05) do 
		if Config.AutoFarm or Config.KillAura then
			local target = getClosestTarget()
			local char = LocalPlayer.Character
			
			if target and char and char:FindFirstChild("HumanoidRootPart") then
				local targetRoot = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso") or target:FindFirstChild("UpperTorso")
				
				if targetRoot then
					-- Auto Farm position lock
					if Config.AutoFarm then
						char.HumanoidRootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 5, 0)
					end
					
					-- Kill Aura execution: Swings weapons through the server link
					if Config.KillAura and (char.HumanoidRootPart.Position - targetRoot.Position).Magnitude <= 25 then
						autoAttack()
						task.wait(Config.AttackSpeed)
					end
				end
			end
		end
	end
end)

task.spawn(function()
	while task.wait(0.5) do
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("Humanoid") then
			char.Humanoid.WalkSpeed = Config.WalkSpeedValue
		end
	end
end)

