---------------------------------------------------------
-- DELTA-SAFE SEARCH ENGINE (Recursive World Scan)
---------------------------------------------------------
local function getClosestTarget()
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	
	local closest, maxDist = nil, math.huge
	local children = workspace:GetChildren()
	
	for i = 1, #children do
		local obj = children[i]
		if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
			if obj.Humanoid.Health > 0 and obj ~= char then
				local dist = (char.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude
				if dist < maxDist then
					maxDist = dist
					closest = obj
				end
			end
		end
	end
	return closest
end

---------------------------------------------------------
-- PERFORMANCE-STABLE CONCURRENT THREADS
---------------------------------------------------------
task.spawn(function()
	while task.wait(0.1) do -- Safe yield loops keep Delta Mobile stable
		if Config.AutoFarm or Config.KillAura then
			local target = getClosestTarget()
			local char = LocalPlayer.Character
			
			if target and char and char:FindFirstChild("HumanoidRootPart") then
				-- Safe Farm Framework: Position player smoothly directly above target head
				if Config.AutoFarm then
					char.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 6, 0)
				end
				
				-- Safe Aura Processing Calculations
				if Config.KillAura and (char.HumanoidRootPart.Position - target.HumanoidRootPart.Position).Magnitude <= 30 then
					target.Humanoid:TakeDamage(15)
					task.wait(Config.AttackSpeed)
				end
			end
		end
	end
end)

task.spawn(function()
	while task.wait(0.5) do
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("Humanoid") then
			char.Humanoid.WalkSpeed = Config.WalkSpeedValue
		end
	end
end)

